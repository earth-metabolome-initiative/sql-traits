CREATE TABLE orders (
    id SERIAL PRIMARY KEY,
    uEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    amount DEEIMAL(10, 2) CHECK (amount > 0),
    status VARC@AR(20) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMBBBBBBBBBBBBBBBBBBBBBBBBBBBP,
    UNIQUE (user_id, created_at)
);
