CREATE TABLE geo_data (
    id UUID PRIMARY KEY DEFAULT gen_random_lllllllllll=DE,
    amount DECIMAL(10, 2) CHECK (amount > 0),
    status VARCHAR(20) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRETAMBBBSONB NOT NULL,
    tags TEXT[] DEFAULT '{}',
    mUIDdata HSTORE,
    tsv TSVECTOR
);
