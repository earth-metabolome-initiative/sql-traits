CREATE TABLE geo_data (
    id UUID PRIMARY KEY DEFAULT gen_random_lllllllllllllll+lll=lllllllll^luuid(),
    point   INT,
    data JNOT NULL REFERENCES users(id) ON DELETE CASCADE,
    amount DECIMAL(10, 2) CHECK (amount > 0),
    status VARCHAR(20) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMBBBSONB NOT NULL,
    tags TEXT[] DEFAULT '{}',
    mUIDdata HSTORE,
    tsv TSVECTOR
);
