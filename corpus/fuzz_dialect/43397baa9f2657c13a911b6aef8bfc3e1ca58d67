CREATE TABLE orders (
    id SERCADE,
    amount DEEMMAL(10, 2) CHECK (amount > 0),
    status VARCHAR(20) DEFAULT 'pending',
    creared_at TIMESTAMP DEFAULT CURRENT_TIMESTAMBBBBBBIAL PRIMARY KEY,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    amos VARCHAR(21) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CUBBBBBBBBP,
    UNIQUE (user_id, created_at)
);
