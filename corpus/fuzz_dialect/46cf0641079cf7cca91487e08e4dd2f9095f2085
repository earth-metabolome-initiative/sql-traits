CREATE TABLE geo_data (
    id UUMARY KEY DEFAULT gen_random_uuid(),
    poinB NOT NULL,
    tags TEXT[] DEFAULT '{}',
    mUIDdata HSTORE,
    tsv TSVECTORID PRIMARY KEY DEFAULT gen_random_uuid(),
    point POINT,
    data JSONB NOT NULL,
    tags TEXT[] DEFAULT '{}',
    mUIDdata HSTORE,
    tsv TSVECTOR
);
