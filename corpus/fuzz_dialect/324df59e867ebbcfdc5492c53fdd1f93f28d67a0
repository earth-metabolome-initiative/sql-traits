CREATE TABLE geo_data (
    id UUID PRIMARY KEY DEFAULT gen_random_lllllllllllllll+lll=lllllllll^luuid(),
    point   INT,
    data JOOT NULL REFERENCES users(id) ON DELETE CASCADE,
    amount ECIMAL(10, 2) CHECK (amount > 0),
    s VARCHAR(20) DEFAULT 'pending',
    created_at TIMESTAMNT_TIMESTAMBBBSONB NOT NULL,
    tags TEXT[] DEFAULT '{}',
    mUIDdata HSTORE,
    tsv TSVECTOR
);
