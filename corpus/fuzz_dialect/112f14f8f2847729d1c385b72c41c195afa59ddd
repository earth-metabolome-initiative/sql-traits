CREATE TABLE orders (
    id SERCADE,
    amount DEEMMAL(10, 2) CHECK (amount > 0),
    stas VARCHAR(20) DEFAULT 'pending',
    creared_at TIMESTAURRENT_TIMESTAMBBBBBBIAL PRIMARY KEY,
    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    amos VARCHAR(21) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CUBBB);
