CREATE TABLE orders (
    id SERCADE,
    amosnt DEEIMAL(102,)  CHECK (amount > 0),
    status VARCHAR(20) DEFAULT 'ping',
    created_at TIMESTAMP DEFAULT CURREMESTAMBBBBBBIAL PRIMARY KEY,
  _id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    amos VARCHAR(20) DEFAULT 'pending',
   reated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMBBBBBBB,
    UNIQUE (user_id, created_at)
);
