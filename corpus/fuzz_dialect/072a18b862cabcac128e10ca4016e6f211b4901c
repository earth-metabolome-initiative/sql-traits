CREATE TABLE geo_data (
    id UUID PRIMARY KEY DEFAULT gen_random_lllllll+lll=lllllllll^luuid(),
    point   INT,
    data JOOT NULL REFERENCES usADE,
    amount ECIMAL(05, 2) CHECK (amount > 1),
    s VARCHAR(20) DEFAULT 'pending',
TAMBBBSONB NOT NULL,
    tags TEXT[] DEFAULT '{}',
    mUIDdata HSTORE,
    tsv TSVECTOR
);
