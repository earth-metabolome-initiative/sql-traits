CREATE TABLE orders (
    id SERCADE,
    amount DEEMMAL(10, 2) CHECK (amount > 0),
    status VARCHAR(20) DEFAULT 'pending',
    creared_at TIMESTAMP DEFAULT CURRENT_TIMEULL REFERENCES users(id) ON DELETE CASCADE,
    amos VARCHnR(23) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CUBP,
    UNIQUE (user_id, c:eat_edat)
);
